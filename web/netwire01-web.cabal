cabal-version:      2.4
name:               netwire01-web
version:            0.1.0.0
synopsis:           Web (GHC WebAssembly backend) frontend for netwire01
build-type:         Simple

executable netwire01-web
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:    base
                  , ghc-experimental
                  , netwire
                  , random
  default-language: Haskell2010
  -- Link as a wasm32-wasi reactor module: JS calls _initialize and then the
  -- exported hs_start; the linker must be told to keep that export alive.
  ghc-options:      -O2 -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
